#include <stdio.h>
#include <stdlib.h>
#include <conio.h>    // 用于检测键盘输入，这是Windows特有的库
#include <windows.h>  // 用于控制台操作和延时，Windows特有库
#include <time.h>
#define LENGTH 30

void cursor_gotoxy(int x,int y)
{
	printf("\033[%d;%dH", y+1, x+1); //转义序列实现光标移动
}




typedef struct SnakeBody{
	int x;
	int y;
	struct SnakeBody *next;
} SnakeBody;

typedef struct{
	SnakeBody *head;
	SnakeBody *tail;
	int len;
} Snake;

int map[LENGTH+2][LENGTH+2];//地图为32*32坐标系，每个位置0代表空，1代表蛇头，2代表蛇体，3代表食物，-1代表边框、
char cur_direction='R';

void initialize(Snake *snake);
void get_direction(void);
void move_snake(Snake *snake);
int check_collusion_or_eat(int new_x,int new_y,Snake *snake);
void gameover(Snake *snake);
void place_food(void);
void free_snake(Snake *snake);

int main(void)
{
	int sleeptime=1000;
	char diff = 'r';
	srand((unsigned int)time(NULL));
	Snake *snake=(Snake*)malloc(sizeof(Snake));
	printf("Select Diffculy:\nEnter 'h' for Hard, 'n' for Normal, 'r' for Rookie");
	diff=getchar();
	initialize(snake);
	switch(diff){
		case 'n': sleeptime=600;break;
		case 'h': sleeptime=200;break;
	}
	while(1){
		get_direction();
		move_snake(snake);
		Sleep(sleeptime);
	}
	return 0;
}

void initialize(Snake *snake)
{
	printf("\033[?25l");
	//初始化蛇
	int head_x=rand()%LENGTH+1;
	int head_y=rand()%LENGTH+1;
	snake->head=(SnakeBody*)malloc(sizeof(SnakeBody));
	snake->head->x=head_x;
	snake->head->y=head_y;
	snake->head->next=NULL;
	snake->tail=snake->head;
	snake->len=1;
	//初始化地图
	int i,j;
	cursor_gotoxy(0,0);
	for(i=0;i<LENGTH+2;i++){
		for(j=0;j<LENGTH+2;j++){
			if(i==0||i==LENGTH+1||j==0||j==LENGTH+1){
				map[i][j]=-1;
			}else{
			    map[i][j]=0;
			}
		}
	}
	system("cls");
	for(i=0;i<LENGTH+2;i++){
		for(j=0;j<LENGTH+2;j++){
			cursor_gotoxy(j,i);
			switch (map[i][j]){
				case -1: printf("#"); break;
				case 0: printf(" "); break;
				case 1: printf("@"); break;
				case 3: printf("F"); break;
			}
		}
	}
	map[head_y][head_x]=1;
	printf("\nUse w,a,s,d to change direction");
	place_food();
}

void get_direction(void)
{
	char drc=cur_direction;
	if(_kbhit()==1){
		char key=_getch();
		switch(key){
			case 'w':drc='U';break;
			case 'a':drc='L';break;
			case 'd':drc='R';break;
			case 's':drc='D';break;
		}
	}
	cur_direction=drc;
}


void move_snake(Snake *snake)
{
	SnakeBody *new_head=(SnakeBody*)malloc(sizeof(SnakeBody));
	map[snake->head->y][snake->head->x]=2;
	cursor_gotoxy(snake->head->x,snake->head->y);
	printf("+");
	int new_x=snake->head->x;
	int new_y=snake->head->y;
	switch(cur_direction){
		case 'U':new_y--;break;
		case 'L':new_x--;break;
		case 'R':new_x++;break;
		case 'D':new_y++;break;
	}
	new_head->x=new_x;
	new_head->y=new_y;
	new_head->next=snake->head;
	snake->head=new_head;
	
	if(check_collusion_or_eat(new_x,new_y,snake)){
		snake->len++;
		place_food();
	}else{
		map[snake->tail->y][snake->tail->x]=0;
		cursor_gotoxy(snake->tail->x,snake->tail->y);
		printf(" ");
		SnakeBody *p=snake->head;
		free(snake->tail);
		while(p->next!=snake->tail){
			p=p->next;
		}
		snake->tail=p;
		snake->tail->next=NULL;
	}
	map[new_y][new_x]=1;
	cursor_gotoxy(new_x,new_y);
	printf("@");
}

void place_food(void)
{
	int food_x,food_y;
	do{
		food_x=rand()%LENGTH+1;
		food_y=rand()%LENGTH+1;
	}while(map[food_y][food_x]!=0);
	map[food_y][food_x]=3;
	cursor_gotoxy(food_x,food_y);
	printf("F");
}


int check_collusion_or_eat(int new_x,int new_y,Snake *snake)//返回1则说明要增长
{
	int eat=0;
	if(map[new_y][new_x]==-1||map[new_y][new_x]==2){
		gameover(snake);
	}else if(map[new_y][new_x]==3){
		(snake->len)++;
		eat=1;
	}
	return eat;
}



void gameover(Snake *snake)
{
	cursor_gotoxy(0,LENGTH+4);
	printf("\n GameOver!");
	free_snake(snake);
	exit(0);
}

void free_snake(Snake *snake)
{
	SnakeBody *current=snake->head;
	while(current!=NULL){
		SnakeBody *next=current->next;
		free(current);
		current=next;
	}
	free(snake);
}







